# ---------------------------------------------------------------------------
# PropPulse AI — copy to backend/.env (backend) and fill in.
# ---------------------------------------------------------------------------

# Security
# dashboard → backend (sent by the Next.js proxy)
ADMIN_API_KEY=change-me-long-random-string
# Cloud Scheduler → /api/cron/daily-proactive-run
CRON_SECRET=change-me-cron-secret
# inbound-email webhook ?token=
INGEST_WEBHOOK_SECRET=change-me-ingest-secret
# X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-secret
FRONTEND_ORIGIN=http://localhost:3000

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase (Project Settings → API). Use the service_role key — backend only!
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (BotFather). The bot must be an admin of the channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@your_property_channel

# Google Calendar — service-account JSON (raw JSON string OR a file path).
# Share the calendar with the service-account email ("Make changes to events").
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Resend
RESEND_API_KEY=
EMAIL_FROM=PropPulse AI <onboarding@resend.dev>
DEMO_FALLBACK_TELEGRAM_CHAT_ID=
DEMO_FALLBACK_EMAIL=

# Business settings
COMPANY_NAME=PropPulse Developments
AGENT_NAME=Liya
TIMEZONE=Africa/Addis_Ababa
CURRENCY=ETB
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
# Mon=0 … Sun=6
WORKING_DAYS=0,1,2,3,4,5
SALES_OFFICE_ADDRESS=Bole Road, Addis Ababa
